# Proxmox VE widget — API token auth
# username must be in the form user@realm!tokenid, e.g. api@pam!homepage
PROXMOX_URL=https://proxmox.host.or.ip:8006
PROXMOX_USERNAME=api@pam!homepage
PROXMOX_PASSWORD=your_proxmox_api_token_secret

# Grafana widget
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=your_grafana_password_or_api_key
