# Copy to .env before starting:  cp .env.example .env

# NOTE: the container runs as a fixed UID:GID 1000:1000. Before first start,
# create the bind-mount dirs so they are owned by 1000:  mkdir -p config data

TZ=Asia/Bangkok

# Web UI — bound to localhost by default; reach it through a reverse proxy.
GUI_BIND=127.0.0.1
GUI_PORT=8384

# Sync protocol (TCP + QUIC/UDP) — must be reachable by peers.
SYNC_PORT=22000

# Local discovery broadcasts (UDP).
DISCOVERY_PORT=21027
