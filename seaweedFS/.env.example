# ── SeaweedFS Docker Compose Environment ──
# Copy this file to `.env` and fill in real values before running:
#   cp .env.example .env

# Image version (pin for production, avoid "latest")
SEAWEEDFS_VERSION=3.71

# ── Master ──
MASTER_PORT=9333
MASTER_GRPC_PORT=19333
VOLUME_SIZE_LIMIT_MB=1024

# ── Volume ──
VOLUME_PORT=8080
VOLUME_GRPC_PORT=18080
VOLUME_MAX=100

# ── Filer ──
FILER_PORT=8888
FILER_GRPC_PORT=18888

# ── S3 Gateway ──
S3_PORT=8333
S3_ACCESS_KEY=changeme_access_key
S3_SECRET_KEY=changeme_secret_key

# ── Data paths (optional, if using host bind mounts instead of named volumes) ──
DATA_ROOT=./data