# Hostname/IP advertised to external clients on the EXTERNAL listener (port 9092).
# Keep "localhost" for host-only access; set to the Docker host's LAN IP to connect
# from other machines.
KAFKA_ADVERTISED_HOST=localhost

# Host port for the Redpanda Console web UI.
KAFKA_CONSOLE_PORT=8085

# KRaft cluster ID. Generate a fresh one with:
#   docker run --rm apache/kafka:3.9.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
