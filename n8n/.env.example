# N8N Configuration
N8N_HOST=n8n.local
N8N_PORT=5678
N8N_PROTOCOL=http

# Backup Configuration
BACKUP_CRON_EXPRESSION=0 3 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_FILENAME=n8n-backup-%Y-%m-%dT%H-%M-%S.tar.gz

# Cloudflare R2 Configuration (AWS S3 Compatible)
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Sandbox service (pin all sandbox-* images to the same version)
N8N_SANDBOX_VERSION=1.13.0
# n8n -> sandbox-api key; must be one of SANDBOX_API_KEYS
N8N_SANDBOX_SERVICE_API_KEY=change-me-api-key
SANDBOX_API_KEYS=change-me-api-key
# sandbox-api and sandbox-runner-1 must share the same token
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me-registration-token
SANDBOX_RUNNER_REGISTRATION_TOKEN=change-me-registration-token
# Optional: model key for Instance AI (commented out in docker-compose.yaml)
# N8N_INSTANCE_AI_MODEL_API_KEY=
