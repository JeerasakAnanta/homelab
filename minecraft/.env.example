# Minecraft — Java Edition server (itzg/minecraft-server)

# Pinned image tag (Java 25 runtime for Minecraft 26.x). Never use :latest.
MINECRAFT_IMAGE_TAG=2026.11.1-java25

# Host binding: 0.0.0.0 relies on the host firewall / Tailscale for access control.
MC_BIND=0.0.0.0
MC_PORT=25565

# Read https://aka.ms/MinecraftEULA and set this to TRUE before the first start.
MC_EULA=FALSE

# Java Edition release; 26.3 needs the Java 25 image tag above.
# Other types: PAPER, PURPUR, FORGE, FABRIC, etc. (may need more memory).
MC_VERSION=26.3
MC_TYPE=VANILLA
MC_MEMORY=1G
MC_MAX_PLAYERS=20
MC_DIFFICULTY=normal
MC_MOTD=Homelab Minecraft
TZ=Asia/Bangkok

# Private by default: comma-separated Java Edition profile names allowed to join.
# Leave empty to deny everyone until you add names here or use /whitelist in-game.
# Set to FALSE only if you deliberately want an open server.
MC_ENABLE_WHITELIST=TRUE
MC_WHITELIST=
