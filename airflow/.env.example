# UID the containers run as. Keep 50000 (the image's built-in "airflow" user) —
# other UIDs have no /etc/passwd entry and Airflow refuses to start.
# Make the bind-mounted dirs writable by it once:
#   docker run --rm -v "$PWD:/mnt" alpine chown -R 50000:0 /mnt/dags /mnt/logs /mnt/plugins /mnt/config
AIRFLOW_UID=50000

# Host port for the web UI (8080 is used by other stacks in this home lab)
AIRFLOW_WEB_PORT=8088

# Web UI admin credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Fernet key for encrypting connections/variables. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Load the bundled example DAGs (true/false)
AIRFLOW_LOAD_EXAMPLES=false

# Extra pip packages installed at container start, space-separated (leave empty for none)
_PIP_ADDITIONAL_REQUIREMENTS=
