# Restic Backup Configuration
# Copy to .env and fill in your values

# S3-compatible storage (SeaweedFS, MinIO, AWS S3, etc.)
S3_ENDPOINT=http://seaweedfs-s3:8333   # Internal SeaweedFS S3 endpoint
S3_BUCKET=homelab-backups              # Bucket name (must exist)

# AWS credentials (for S3-compatible)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Restic repository password (ENCRYPTION KEY - KEEP SAFE!)
RESTIC_PASSWORD=your_strong_random_password_here

# Backup schedules (cron format)
BACKUP_SCHEDULE=0 2 * * *    # Daily at 2:00 AM
PRUNE_SCHEDULE=0 4 * * 0     # Weekly Sunday 4:00 AM
CHECK_SCHEDULE=0 6 * * 0     # Weekly Sunday 6:00 AM