# Copy to .env before starting:  cp .env.example .env
# Full list of settings: https://github.com/DuarteSantos8/openGym/blob/main/.env.example

# Host port for the web UI (8080 is taken by several other stacks here).
WEB_PORT=8095

# Passkeys bind to the exact hostname and need HTTPS (or localhost).
# Put a TLS proxy (Traefik/Cloudflare) in front of WEB_PORT, then set:
#   RP_ID=gym.example.com   ORIGIN=https://gym.example.com
# Changing RP_ID later invalidates every registered passkey.
RP_ID=localhost
ORIGIN=http://localhost:8095
RP_NAME=openGym

# Register your own profile first: with FIRST_USER_ADMIN=1 the first profile
# becomes admin. Then consider INVITE_ONLY=1 since this is on a public VPS.
FIRST_USER_ADMIN=1
#INVITE_ONLY=1
#ALLOW_GUEST=0

# Only if Cloudflare is genuinely in front (it overwrites the header):
#CF_CONNECTING_IP=$$http_cf_connecting_ip
