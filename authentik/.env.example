# Copy to .env (or enter these in DockHand's per-stack UI).
AUTHENTIK_VERSION=2026.8.6
AUTHENTIK_PORT=9400
# Interface to bind. 0.0.0.0 = all (Tailscale + public IP); use the Tailscale IP to keep it internal.
AUTHENTIK_BIND=0.0.0.0

# openssl rand -base64 60 — never change it after first start.
AUTHENTIK_SECRET_KEY=change-me-secret-key

AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_DB=authentik
AUTHENTIK_PG_PASSWORD=change-me-db-password

# First admin (akadmin); only read on the very first start.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-admin-password
